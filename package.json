{
  "name": "zotero-context",
  "type": "module",
  "version": "0.0.0",
  "description": "A Zotero plugin to ferry context for active readers",
  "config": {
    "addonName": "Zotero Context",
    "addonID": "zotero-context@jamesbraza.com",
    "addonRef": "zoterocontext",
    "addonInstance": "ZoteroContext",
    "prefsPrefix": "extensions.zotero.zoterocontext"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesbraza/zotero-context.git"
  },
  "author": "James Braza",
  "bugs": {
    "url": "https://github.com/jamesbraza/zotero-context/issues"
  },
  "homepage": "https://github.com/jamesbraza/zotero-context",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "release": "[ \"$CI\" = true ] || { echo 'npm run release is CI-only: cut a GitHub release instead'; exit 1; }; zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@zotero-plugin/eslint-config": "^0.6.9",
    "chai": "^6.2.2",
    "eslint": "^10.7.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.7",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
